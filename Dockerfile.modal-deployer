FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir "modal==1.5.0"

COPY modal ./modal
COPY scripts/verify-modal-videochat3.py ./scripts/verify-modal-videochat3.py

# The actual Modal publish happens in Railway's pre-deploy command.
# Keep this tiny service alive so Railway has a stable source-triggered service.
CMD ["python", "-c", "import time; time.sleep(31536000)"]
