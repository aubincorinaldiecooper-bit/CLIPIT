# =============================================================================
# CLIPIT backend configuration
# Copy to .env for local development. Never commit real credentials.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
API_CORS_ORIGIN=*
TRUST_PROXY=true

# --- Postgres ----------------------------------------------------------------
DATABASE_URL=postgres://clipit:clipit@localhost:5432/clipit
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- S3-compatible storage ---------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
BUCKET_NAME=clipit
S3_FORCE_PATH_STYLE=true
SIGNED_URL_EXPIRY_SECONDS=3600
UPLOAD_URL_EXPIRY_SECONDS=3600
BUCKET_CORS_AUTOCONFIGURE=true
BUCKET_CORS_ORIGINS=

# --- Current video retrieval -------------------------------------------------
# SimpleMem is the memory/index layer. Candidates are verified against actual
# footage before they become visual evidence.
SIMPLEMEM_URL=http://127.0.0.1:8080
SIMPLEMEM_INTERNAL_TOKEN=
# Production indexes uploads. Local development may set this false when the
# SimpleMem sidecar is not running.
SIMPLEMEM_INDEX_ENABLED=false
SIMPLEMEM_FRAME_FPS=1
SIMPLEMEM_MAX_FRAMES=21600
SIMPLEMEM_TOP_K=20
SIMPLEMEM_MIN_SCORE=0
SIMPLEMEM_GROUP_GAP_SECONDS=5
SIMPLEMEM_REQUEST_TIMEOUT_MS=60000
SIMPLEMEM_INDEX_TIMEOUT_MS=3600000
# clipit = direct actual-footage search first
# simplemem = SimpleMem first, followed by actual-footage verification/fallback
RETRIEVAL_PRIMARY=clipit

# --- Actual-footage video provider ------------------------------------------
# openrouter = hosted Qwen path
# minicpm    = self-hosted MiniCPM-V 4.6 on Modal
VIDEO_PROVIDER=openrouter

OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=qwen/qwen3.6-flash
OPENROUTER_VIDEO_CONCURRENCY=8
OPENROUTER_VIDEO_MAX_TOKENS=1024
OPENROUTER_VIDEO_REASONING_MAX_TOKENS=2500
OPENROUTER_VIDEO_TEMPERATURE=0.1
OPENROUTER_REQUEST_TIMEOUT_MS=300000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Text-only final answer over evidence already grounded by retrieval.
OPENROUTER_ANSWER_MODEL=qwen/qwen3.6-flash
OPENROUTER_ANSWER_MAX_TOKENS=700
OPENROUTER_ANSWER_TEMPERATURE=0.1

# Optional self-hosted MiniCPM provider on Modal.
MODAL_APP_NAME=clipit-minicpm-v46
MODAL_CLASS_NAME=MiniCPMVideoService
MODAL_ENVIRONMENT=main
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MINICPM_REQUEST_TIMEOUT_SECONDS=900
MINICPM_VIDEO_CONCURRENCY=1
MINICPM_MAX_RETRIES=2
MINICPM_WARM_ON_UPLOAD=true
MINICPM_WARM_IDLE_SECONDS=300
MODAL_L4_USD_PER_GPU_HOUR=

# --- Speech-to-text ----------------------------------------------------------
TRANSCRIPTION_ENABLED=true
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_STT_CONCURRENCY=2
TRANSCRIBE_SEGMENT_SECONDS=900
TRANSCRIBE_AUDIO_BITRATE=48k
TRANSCRIBE_LANGUAGE=

# --- Sessions & rate limiting ------------------------------------------------
SESSION_TTL_SECONDS=2592000
REQUIRE_SESSION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSION_CREATE_PER_IP_HOURLY=30
RATE_LIMIT_VIDEOS_PER_SESSION_HOURLY=10
RATE_LIMIT_VIDEOS_PER_IP_HOURLY=30
RATE_LIMIT_SEARCH_PER_SESSION_HOURLY=20
RATE_LIMIT_SEARCH_PER_IP_HOURLY=60
RATE_LIMIT_GENERATE_PER_SESSION_HOURLY=60
RATE_LIMIT_GENERATE_PER_IP_HOURLY=180
RATE_LIMIT_READ_PER_SESSION_MINUTE=240

# --- Media pipeline ----------------------------------------------------------
MAX_SOURCE_DURATION_SECONDS=21600
ANALYSIS_CHUNK_SECONDS=120
PROXY_HEIGHT=360
PROXY_FPS=2
PROXY_CRF=30
PROXY_PRESET=veryfast
CLIP_PADDING_SECONDS=1.5
MIN_CLIP_SECONDS=2
MAX_CLIP_SECONDS=300
CLIP_VIDEO_CRF=20
CLIP_PRESET=veryfast
CLIP_AUDIO_BITRATE=160k
CLIP_MAX_SHORT_SIDE=1080
MIN_MATCH_CONFIDENCE=0.3
MATCH_MERGE_GAP_SECONDS=1.5
MATCH_MERGE_MIN_OVERLAP_RATIO=0.5
CLIP_SEARCH_MODE=auto
TRANSCRIPT_WAIT_TIMEOUT_MS=600000
TRANSCRIPT_WAIT_POLL_MS=10000

# Every new deliverable is 9:16. These control vertical rendering quality.
VERTICAL_MIN_CROP_WIDTH=540
VERTICAL_CANDIDATE_OVERFETCH=1.7
VERTICAL_CANDIDATE_CEILING=8
VERTICAL_MAX_RENDER_ATTEMPTS=2
RECLIP_CONTEXT_BEFORE_SECONDS=10
RECLIP_CONTEXT_AFTER_SECONDS=10
MAX_RECLIPS_PER_MOMENT=2

# --- Retention / background work --------------------------------------------
FOOTAGE_IDLE_SECONDS=86400
RETENTION_SWEEP_ENABLED=true
THUMBNAIL_BACKFILL_ON_START=false
LEARNING_REPORT_ENABLED=true

# --- Binaries / scratch ------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORK_DIR=/tmp/clipit

# --- Worker concurrency ------------------------------------------------------
INGESTION_CONCURRENCY=2
PREPROCESS_CONCURRENCY=2
TRANSCRIPTION_CONCURRENCY=2
CLIP_SEARCH_CONCURRENCY=2
CLIP_GENERATION_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# --- Evaluation --------------------------------------------------------------
EVAL_OWNER_EMAILS=

# --- Social publishing (Zernio) ---------------------------------------------
ZERNIO_BASE_URL=
ZERNIO_API_KEY=
ZERNIO_CONNECT_REDIRECT_URL=
ZERNIO_WEBHOOK_SECRET=
FRONTEND_URL=

# --- Team invitations --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=
