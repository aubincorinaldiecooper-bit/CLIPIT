# =============================================================================
# CLIPIT backend configuration
#
# Copy to .env for local development. Never commit a filled-in .env: every
# value below marked SECRET is a credential.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
# Comma-separated origins, or * for any.
API_CORS_ORIGIN=*
# Trust X-Forwarded-For. Leave true on Railway (TLS terminates at its proxy).
TRUST_PROXY=true

# --- Postgres ----------------------------------------------------------------
# On Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://clipit:clipit@localhost:5432/clipit
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Redis (BullMQ) ----------------------------------------------------------
# On Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# --- Storage (S3-compatible: Railway bucket, AWS S3, R2, MinIO) --------------
AWS_ACCESS_KEY_ID=                 # SECRET
AWS_SECRET_ACCESS_KEY=             # SECRET
# Leave empty for real AWS S3; set for Railway buckets / MinIO / R2.
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
BUCKET_NAME=clipit
# Path-style addressing; required by most non-AWS S3 implementations.
S3_FORCE_PATH_STYLE=true
# Lifetime of playback URLs returned for generated clips.
SIGNED_URL_EXPIRY_SECONDS=3600
# Lifetime of presigned upload URLs.
UPLOAD_URL_EXPIRY_SECONDS=3600
# Browsers PUT straight to the bucket, so the bucket needs a CORS rule naming
# the frontend's origin or the upload is blocked with no HTTP status at all.
# The API applies the rule on boot; set false if you manage the policy yourself.
BUCKET_CORS_AUTOCONFIGURE=true
# Comma-separated origins allowed to upload. Defaults to API_CORS_ORIGIN.
BUCKET_CORS_ORIGINS=

# --- MiniCPM-V (clip search) -------------------------------------------------
MINICPM_API_BASE_URL=https://api.modelbest.cn/v1
MINICPM_API_KEY=                   # SECRET — required, the process exits without it
MINICPM_MODEL=MiniCPM-V-4.6-1B
# Maximum simultaneous model requests, process-wide.
MINICPM_CONCURRENCY=2
MINICPM_REQUEST_TIMEOUT_MS=180000
MINICPM_MAX_RETRIES=3
MINICPM_MAX_TOKENS=1024
MINICPM_TEMPERATURE=0.1
# Frames per chunk for the FALLBACK query-time visual search — used only when a
# video has no scene index. 128 frames measured ~208k prompt tokens, past every
# current model's context window; this must stay sized to fit in one request.
MINICPM_FRAMES_PER_CHUNK=32
MINICPM_FRAME_MAX_WIDTH=448
MINICPM_FRAME_JPEG_QUALITY=4

# --- Scene index (ingest-time visual understanding) --------------------------
# The model reads each video ONCE at upload into timestamped scene
# descriptions; queries then answer from that index as text in one small
# request, instead of re-sending frames to the model on every search.
INDEXING_ENABLED=true
# Frames sampled per analysis chunk while building the index.
INDEX_FRAMES_PER_CHUNK=48
# Frames per model call during indexing; batches stay far inside any context
# window. A chunk is indexed across ceil(PER_CHUNK / PER_CALL) calls.
INDEX_FRAMES_PER_CALL=16
INDEXING_CONCURRENCY=2
# How long a visual search waits for an in-flight index before falling back
# to the per-chunk frame search.
INDEX_WAIT_TIMEOUT_MS=900000
# Verify index-search matches against the frames actually on screen before
# reporting them: confirmed moments get refined timestamps, unconfirmed ones
# are demoted. This is what makes a match trustworthy despite the index's
# frame-sampling granularity.
VERIFY_MATCHES=true
VERIFY_FRAMES=8
VERIFY_MAX_MATCHES=8
VERIFY_PAD_SECONDS=3

# --- Transcription (OpenRouter speech-to-text) -------------------------------
# Set false to run visual-only search with no STT dependency.
TRANSCRIPTION_ENABLED=true
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=                # SECRET — required when TRANSCRIPTION_ENABLED=true
OPENROUTER_STT_MODEL=openai/whisper-1
# Optional attribution headers used by OpenRouter's app rankings.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=
OPENROUTER_STT_CONCURRENCY=2
OPENROUTER_REQUEST_TIMEOUT_MS=300000
OPENROUTER_MAX_RETRIES=3
# Audio is extracted once from the full source, then split into pieces of this
# length purely to respect the STT request-size limit. Unrelated to
# ANALYSIS_CHUNK_SECONDS.
TRANSCRIBE_SEGMENT_SECONDS=900
TRANSCRIBE_AUDIO_BITRATE=48k
# Optional ISO-639-1 hint, e.g. en. Leave empty to auto-detect.
TRANSCRIBE_LANGUAGE=
# Use yt-dlp creator/auto captions before paying for STT.
YOUTUBE_PREFER_CAPTIONS=true
YOUTUBE_CAPTION_LANGS=en.*,en

# --- Sessions & rate limiting ------------------------------------------------
SESSION_TTL_SECONDS=2592000
# Set false only for local development without session tokens.
REQUIRE_SESSION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSION_CREATE_PER_IP_HOURLY=30
RATE_LIMIT_VIDEOS_PER_SESSION_HOURLY=10
RATE_LIMIT_VIDEOS_PER_IP_HOURLY=30
RATE_LIMIT_SEARCH_PER_SESSION_HOURLY=20
RATE_LIMIT_SEARCH_PER_IP_HOURLY=60
RATE_LIMIT_GENERATE_PER_SESSION_HOURLY=60
RATE_LIMIT_GENERATE_PER_IP_HOURLY=180
RATE_LIMIT_READ_PER_SESSION_MINUTE=240

# --- Media pipeline ----------------------------------------------------------
# Longest source accepted, in seconds (default 6 hours).
MAX_SOURCE_DURATION_SECONDS=21600
# Length of each analysis chunk sent to the model (default 10 minutes).
ANALYSIS_CHUNK_SECONDS=600
# Analysis proxy: small and cheap, used only for search. Clips always come
# from the original source.
PROXY_HEIGHT=360
PROXY_FPS=2
PROXY_CRF=30
PROXY_PRESET=veryfast
# Handles added to each side of a match when cutting.
CLIP_PADDING_SECONDS=1.5
MIN_CLIP_SECONDS=2
MAX_CLIP_SECONDS=300
CLIP_VIDEO_CRF=20
CLIP_PRESET=veryfast
CLIP_AUDIO_BITRATE=160k
# Matches below this confidence are discarded.
MIN_MATCH_CONFIDENCE=0.3
# Aggregation-stage merging: matches separated by no more than this gap (a
# moment split across a chunk boundary), or overlapping by at least this share
# of the shorter match (a duplicate detection), collapse into one.
MATCH_MERGE_GAP_SECONDS=1.5
MATCH_MERGE_MIN_OVERLAP_RATIO=0.5
# Prompt-size ceiling for ONE index-backed search request. A multi-hour
# transcript exceeds any context window, so past this estimate the timeline is
# split into ordered windows and searched in several requests — never truncated.
SEARCH_TOKEN_BUDGET=100000
# auto | visual | transcript | both — default when a request does not pin one.
CLIP_SEARCH_MODE=auto
# How long a search waits for an in-flight transcript before going visual-only.
TRANSCRIPT_WAIT_TIMEOUT_MS=600000
TRANSCRIPT_WAIT_POLL_MS=10000

# --- Binaries ----------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
YTDLP_FORMAT=bv*[height<=1080]+ba/b[height<=1080]/b
# JS runtimes yt-dlp may use for YouTube's signature challenges. Opt-in, and
# YouTube extraction fails without one. The image is Node-based, so leave this.
YTDLP_JS_RUNTIMES=node
# Base URL of a bgutil PO-token provider. YouTube demands a Proof-of-Origin
# token from flagged IP ranges — most of any cloud host — and otherwise answers
# "Sign in to confirm you're not a bot". This is the primary remedy; run the
# provider alongside the worker and point this at it. See the README.
YTDLP_POT_BASE_URL=
# Fallback remedy: a cookie jar from a logged-in browser (Netscape format),
# supplied EITHER as a path or inline as the file's contents. The inline form is
# written to disk at startup, which is what a container without persistent
# storage needs. Use a throwaway Google account — these are live session
# cookies — and expect to refresh them.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_CONTENT=
# Last-resort remedy: route yt-dlp (only) through a residential address, since
# the block is on the source IP. http(s) or socks5://user:pass@host:1080
YTDLP_PROXY=
# Run yt-dlp with --verbose and log its full stderr on failure. Turn on to see
# which player clients were tried and whether the PO-token provider was
# consulted; off by default because the output is large.
YTDLP_VERBOSE=false
# Passed to yt-dlp's --extractor-args. Bot checks vary by player client, so an
# alternative client can be tried without a deploy, e.g.
# youtube:player_client=android
YTDLP_EXTRACTOR_ARGS=
# Transient scratch space for ffmpeg / yt-dlp.
WORK_DIR=/tmp/clipit

# --- Worker concurrency ------------------------------------------------------
INGESTION_CONCURRENCY=2
PREPROCESS_CONCURRENCY=2
TRANSCRIPTION_CONCURRENCY=2
CLIP_SEARCH_CONCURRENCY=2
CLIP_GENERATION_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
